# ============================================================
# NEXT.JS
# ============================================================
NEXT_PUBLIC_SITE_URL=https://www.lhermineetlevair.com
# In dev: http://localhost:3000

# ============================================================
# SUPABASE — Client (safe to expose)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# SUPABASE — Server Only (NEVER expose to client)
# ============================================================
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Used only in: withAudit wrapper, webhook handlers, scheduled functions

SUPABASE_JWT_SECRET=your-jwt-secret
# Used only in: custom JWT verification if needed

# ============================================================
# SANITY — Client (safe to expose)
# ============================================================
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
# For staging: staging
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# ============================================================
# SANITY — Server Only (NEVER expose to client)
# ============================================================
SANITY_API_WRITE_TOKEN=skXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Used only in: server-side Sanity mutations (rare), migration scripts

SANITY_WEBHOOK_SECRET=your-webhook-secret
# Used in: /api/revalidate/route.ts to verify Sanity webhook calls

# ============================================================
# RESEND — Server Only (NEVER expose to client)
# ============================================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Used only in: server-side email sending (Route Handlers, Server Actions, Netlify Functions)

STAFF_ALERT_EMAILS=owner@example.com,admin@example.com
# Comma-separated; used for low-stock and failed-payment alerts

# ============================================================
# STRIPE — Mixed
# ============================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Used in: client-side Stripe.js initialization (safe)

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Used only in: checkout Session creation, webhook verification (server-side)

STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Used only in: /api/webhooks/stripe/route.ts for signature verification

# ============================================================
# REVALIDATION
# ============================================================
REVALIDATE_SECRET=your-long-random-secret-string
# Used in: /api/revalidate/route.ts; sent as header from Sanity & Supabase webhooks

# ============================================================
# CRON (Netlify Scheduled Functions)
# ============================================================
CRON_SECRET=your-cron-secret
# Sent as Authorization header to internal scheduled function endpoints
